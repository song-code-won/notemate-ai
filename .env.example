# NoteMate AI Configuration

# Ollama Endpoint & Model (Local Open-Weight AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/notes.db

# Speech-to-Text Whisper Model (tiny, base, small)
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu

# App Server Settings
HOST=0.0.0.0
PORT=8000
